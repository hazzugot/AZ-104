# ============================================================================
# AZ-104 Platform Environment Variables
# Copy to .env (local) or configure in your deployment platform.
# ============================================================================

# --- Database (PostgreSQL with pgvector extension recommended) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/az104?schema=public"

# --- Redis (caching + BullMQ queues) ---
REDIS_URL="redis://localhost:6379"
# Optional Upstash REST credentials for serverless rate limiting
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- NextAuth ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# --- Anthropic ---
ANTHROPIC_API_KEY=""
# Model identifiers - tuned for cost vs quality
ANTHROPIC_FAST_MODEL="claude-haiku-4-5-20251001"
ANTHROPIC_SMART_MODEL="claude-sonnet-4-6"

# --- OpenAI-compatible fallback (for embeddings / future provider swap) ---
OPENAI_BASE_URL=""
OPENAI_API_KEY=""
EMBEDDING_MODEL="text-embedding-3-small"

# --- Scraper ---
MS_LEARN_BASE_URL="https://learn.microsoft.com"
SCRAPER_USER_AGENT="AZ104-Platform-Edu-Bot/1.0 (+contact@example.com)"
SCRAPER_RATE_LIMIT_MS="1500"

# --- Observability ---
LOG_LEVEL="info"
SENTRY_DSN=""

# --- Feature flags ---
ENABLE_VECTOR_SEARCH="true"
ENABLE_AI_EXAM_GENERATION="true"
