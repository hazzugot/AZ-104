// AZ-104 Platform — Prisma schema
// Postgres with pgvector for semantic search (RAG over Microsoft Learn content).
// Run: `pnpm prisma migrate dev` after enabling the pgvector extension.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "fullTextSearchPostgres"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

// ───────────────────────────────────────────────────────────────────────────
// Identity & access
// ───────────────────────────────────────────────────────────────────────────

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  emailVerified   DateTime?
  name            String?
  image           String?
  passwordHash    String?
  role            Role      @default(STUDENT)
  timezone        String    @default("UTC")
  examTargetDate  DateTime?
  streakDays      Int       @default(0)
  lastActiveAt    DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  progress        UnitProgress[]
  examAttempts    ExamAttempt[]
  questionAttempts QuestionAttempt[]
  flashcardReviews FlashcardReview[]
  studyPlans      StudyPlan[]
  tutorThreads    TutorThread[]
  confidence      TopicConfidence[]
  auditLogs       AuditLog[]

  @@index([role])
  @@index([lastActiveAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ───────────────────────────────────────────────────────────────────────────
// Curriculum: Module → Unit → ContentBlock
// Mirrors Microsoft Learn structure (learning paths → modules → units).
// ───────────────────────────────────────────────────────────────────────────

enum ContentLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ExamObjective {
  IDENTITIES_GOVERNANCE       // ~20-25% of AZ-104
  STORAGE                     // ~15-20%
  COMPUTE                     // ~20-25%
  VIRTUAL_NETWORKING          // ~15-20%
  MONITORING_BACKUP           // ~10-15%
}

model LearningPath {
  id           String    @id @default(cuid())
  slug         String    @unique
  title        String
  description  String    @db.Text
  sourceUrl    String?   @unique
  orderIndex   Int       @default(0)
  modules      Module[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Module {
  id            String         @id @default(cuid())
  slug          String         @unique
  title         String
  summary       String         @db.Text
  objective     ExamObjective
  level         ContentLevel   @default(INTERMEDIATE)
  estimatedMin  Int            @default(30)
  examWeight    Float          @default(0)
  orderIndex    Int            @default(0)
  sourceUrl     String?        @unique
  contentHash   String?        // sha256 of raw scraped HTML, for change detection
  pathId        String?
  path          LearningPath?  @relation(fields: [pathId], references: [id])
  units         Unit[]
  flashcards    Flashcard[]
  examQuestions ExamQuestion[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([objective])
  @@index([pathId, orderIndex])
}

model Unit {
  id              String         @id @default(cuid())
  slug            String
  moduleId        String
  module          Module         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title           String
  kind            UnitKind       @default(LESSON)
  orderIndex      Int            @default(0)
  estimatedMin    Int            @default(5)
  sourceUrl       String?
  contentHash     String?

  // Multi-level explanations generated/curated by the AI pipeline.
  bodyMarkdown    String?        @db.Text  // primary lesson body
  beginnerNotes   String?        @db.Text
  advancedNotes   String?        @db.Text
  examTips        String?        @db.Text
  commonMistakes  String?        @db.Text
  realWorldUseCases String?      @db.Text
  keyTerms        Json?          // [{term, definition}]
  likelyOnExam    Boolean        @default(false)
  likelyExamScore Float          @default(0) // 0..1 confidence
  rawScrapedHtml  String?        @db.Text

  blocks          ContentBlock[]
  transcripts     Transcript[]
  knowledgeChecks KnowledgeCheck[]
  progress        UnitProgress[]
  flashcards      Flashcard[]
  labGuide        LabGuide?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([moduleId, slug])
  @@index([moduleId, orderIndex])
  @@index([likelyOnExam])
}

enum UnitKind {
  LESSON
  LAB
  QUIZ
  REVIEW
  EXERCISE
}

enum BlockKind {
  HEADING
  PARAGRAPH
  CODE
  TABLE
  LIST
  CALLOUT
  IMAGE
  LINK
}

model ContentBlock {
  id         String    @id @default(cuid())
  unitId     String
  unit       Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  kind       BlockKind
  orderIndex Int
  text       String?   @db.Text
  language   String?   // for CODE blocks (azurecli, powershell, bicep, json...)
  meta       Json?     // table rows, image alt text, link metadata, etc.

  // Vector embedding for semantic search / RAG grounding.
  embedding  Unsupported("vector(1536)")?

  @@index([unitId, orderIndex])
}

// ───────────────────────────────────────────────────────────────────────────
// Transcripts
// ───────────────────────────────────────────────────────────────────────────

model Transcript {
  id          String             @id @default(cuid())
  unitId      String?
  unit        Unit?              @relation(fields: [unitId], references: [id], onDelete: SetNull)
  sourceUrl   String
  videoTitle  String?
  language    String             @default("en")
  rawText     String             @db.Text
  cleanedText String?            @db.Text
  summary     String?            @db.Text
  takeaways   Json?              // string[]
  status      ProcessingStatus   @default(PENDING)
  chunks      TranscriptChunk[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([status])
}

model TranscriptChunk {
  id           String    @id @default(cuid())
  transcriptId String
  transcript   Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  orderIndex   Int
  startSec     Float
  endSec       Float
  text         String    @db.Text
  topic        String?
  embedding    Unsupported("vector(1536)")?

  @@index([transcriptId, orderIndex])
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ───────────────────────────────────────────────────────────────────────────
// Knowledge checks, flashcards, labs
// ───────────────────────────────────────────────────────────────────────────

model KnowledgeCheck {
  id         String   @id @default(cuid())
  unitId     String
  unit       Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  prompt     String   @db.Text
  options    Json     // [{id, text, isCorrect, rationale}]
  explanation String  @db.Text
  difficulty Int      @default(2) // 1..5
  createdAt  DateTime @default(now())
}

model Flashcard {
  id           String           @id @default(cuid())
  moduleId     String?
  module       Module?          @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  unitId       String?
  unit         Unit?            @relation(fields: [unitId], references: [id], onDelete: SetNull)
  front        String           @db.Text
  back         String           @db.Text
  mnemonic     String?          @db.Text
  category     String?
  difficulty   Int              @default(2)
  source       FlashcardSource  @default(AI_GENERATED)
  reviews      FlashcardReview[]
  createdAt    DateTime         @default(now())

  @@index([moduleId])
  @@index([category])
}

enum FlashcardSource {
  AI_GENERATED
  CURATED
  USER_AUTHORED
}

model FlashcardReview {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  flashcardId   String
  flashcard     Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  // SM-2 spaced repetition state
  easeFactor    Float     @default(2.5)
  intervalDays  Int       @default(0)
  repetitions   Int       @default(0)
  dueAt         DateTime  @default(now())
  lastGrade     Int?      // 0..5 user self-grade
  reviewedAt    DateTime  @default(now())

  @@unique([userId, flashcardId])
  @@index([userId, dueAt])
}

model LabGuide {
  id          String   @id @default(cuid())
  unitId      String   @unique
  unit        Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  title       String
  objective   String   @db.Text
  steps       Json     // [{title, description, portal?, cli?, powershell?, bicep?, terraform?, validation?, troubleshooting?}]
  prerequisites String? @db.Text
  cleanupSteps String? @db.Text
  estimatedMin Int     @default(20)
  createdAt   DateTime @default(now())
}

// ───────────────────────────────────────────────────────────────────────────
// Exams (practice + adaptive)
// ───────────────────────────────────────────────────────────────────────────

enum QuestionType {
  MULTIPLE_CHOICE
  MULTIPLE_RESPONSE
  DRAG_DROP
  CASE_STUDY
  SCENARIO
  ARCHITECTURE
  CLI_TROUBLESHOOT
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
  EXPERT
}

model ExamQuestion {
  id            String        @id @default(cuid())
  moduleId      String?
  module        Module?       @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  objective     ExamObjective
  type          QuestionType
  difficulty    Difficulty    @default(MEDIUM)
  stem          String        @db.Text       // scenario / question text
  caseStudy     String?       @db.Text       // longer case context if applicable
  options       Json          // [{id, text}]
  correctIds    Json          // string[]
  explanation   String        @db.Text       // why correct
  distractorRationale Json?   // { optionId: "why this is wrong" }
  references    Json?         // [{title, url}]
  tags          String[]
  source        QuestionSource @default(AI_GENERATED)
  reviewStatus  ReviewStatus   @default(NEEDS_REVIEW)
  qualityScore  Float          @default(0)
  promptVersion String?        // links to PromptVersion.id for audit
  attempts      QuestionAttempt[]
  examItems     ExamItem[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([objective, difficulty])
  @@index([reviewStatus])
  @@index([tags], type: Gin)
}

enum QuestionSource {
  AI_GENERATED
  EXPERT_AUTHORED
  IMPORTED
}

enum ReviewStatus {
  NEEDS_REVIEW
  APPROVED
  REJECTED
}

enum ExamMode {
  TIMED
  REVIEW
  STUDY
  ADAPTIVE
  WEAK_AREA
}

model Exam {
  id           String      @id @default(cuid())
  title        String
  mode         ExamMode
  durationMin  Int         @default(120)
  passingScore Int         @default(700) // Microsoft 1-1000 scale
  // Weighting per objective; must sum to ~1.0
  objectiveWeights Json    @default("{}")
  items        ExamItem[]
  attempts     ExamAttempt[]
  createdAt    DateTime    @default(now())
}

model ExamItem {
  id         String       @id @default(cuid())
  examId     String
  exam       Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  questionId String
  question   ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  orderIndex Int

  @@unique([examId, questionId])
  @@index([examId, orderIndex])
}

model ExamAttempt {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  examId        String
  exam          Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  startedAt     DateTime   @default(now())
  submittedAt   DateTime?
  scaledScore   Int?       // Microsoft 1-1000
  rawPercent    Float?
  passed        Boolean?
  perObjective  Json?      // { OBJECTIVE: { correct, total, percent } }
  durationSec   Int?
  questionAttempts QuestionAttempt[]

  @@index([userId, startedAt])
}

model QuestionAttempt {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  attemptId    String?
  attempt      ExamAttempt? @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId   String
  question     ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedIds  Json         // string[]
  isCorrect    Boolean
  timeSpentSec Int          @default(0)
  confidence   Int?         // 1..5 user self-report
  createdAt    DateTime     @default(now())

  @@index([userId, questionId])
  @@index([questionId, isCorrect])
}

// ───────────────────────────────────────────────────────────────────────────
// Adaptive learning state
// ───────────────────────────────────────────────────────────────────────────

model UnitProgress {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  unitId        String
  unit          Unit       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  status        ProgressStatus @default(NOT_STARTED)
  percentRead   Float      @default(0)
  timeSpentSec  Int        @default(0)
  lastViewedAt  DateTime   @default(now())

  @@unique([userId, unitId])
  @@index([userId, status])
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  MASTERED
}

model TopicConfidence {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  objective  ExamObjective
  // Running estimate combining quiz performance + self-report.
  mastery    Float          @default(0) // 0..1
  lastDecay  DateTime       @default(now())

  @@unique([userId, objective])
}

model StudyPlan {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  examDate    DateTime?
  weeklyHours Int      @default(8)
  items       Json     // [{date, type, refId, durationMin}]
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, active])
}

// ───────────────────────────────────────────────────────────────────────────
// AI tutor & generation audit
// ───────────────────────────────────────────────────────────────────────────

model TutorThread {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String?
  unitId      String?       // optional anchor
  messages    TutorMessage[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId, updatedAt])
}

enum TutorRole {
  USER
  ASSISTANT
  SYSTEM
}

model TutorMessage {
  id        String      @id @default(cuid())
  threadId  String
  thread    TutorThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role      TutorRole
  content   String      @db.Text
  citations Json?       // [{title, url, unitId?}]
  model     String?
  costUsd   Float?
  createdAt DateTime    @default(now())

  @@index([threadId, createdAt])
}

model AIGeneration {
  id            String   @id @default(cuid())
  kind          String   // "exam_question" | "summary" | "flashcard" | "tutor_reply" | ...
  model         String
  promptVersion String?
  inputTokens   Int      @default(0)
  outputTokens  Int      @default(0)
  costUsd       Float    @default(0)
  latencyMs     Int      @default(0)
  cacheHit      Boolean  @default(false)
  refTable      String?
  refId         String?
  createdAt     DateTime @default(now())

  @@index([kind, createdAt])
  @@index([model, createdAt])
}

model PromptVersion {
  id          String   @id @default(cuid())
  name        String
  version     String
  template    String   @db.Text
  fewShots    Json?
  systemPrompt String? @db.Text
  active      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@unique([name, version])
}

// ───────────────────────────────────────────────────────────────────────────
// Operations
// ───────────────────────────────────────────────────────────────────────────

model ScrapeJob {
  id          String           @id @default(cuid())
  url         String
  kind        String           // "path" | "module" | "unit"
  status      ProcessingStatus @default(PENDING)
  attempts    Int              @default(0)
  lastError   String?          @db.Text
  startedAt   DateTime?
  finishedAt  DateTime?
  resultRefId String?
  createdAt   DateTime         @default(now())

  @@index([status])
  @@unique([url, kind])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  target    String?
  meta      Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([action, createdAt])
}
